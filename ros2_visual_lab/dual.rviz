Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 24; 30; 42
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Native plants and estimates (wheelbase units)
      Topic:
        Value: /lab/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 56
      Pitch: 1.4
      Yaw: 4.71
      Focal Point:
        X: 12
        Y: 8
        Z: 0
      Name: Current View
Window Geometry:
  Width: 1400
  Height: 850
